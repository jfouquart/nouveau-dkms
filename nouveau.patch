+			for (i = 0; i < 20; i++) {
+				cur = nvkm_clk_read(device->clk, nv_clk_src_mem);
+				if (cur && abs((int)cur - (int)freq) < (int)(freq / 20))
+					break;
+				udelay(5);
+			}
+			if (!cur || abs((int)cur - (int)freq) >= (int)(freq / 20)) {
+				deadline = jiffies + msecs_to_jiffies(100);
+				do {
+					cur = nvkm_clk_read(device->clk, nv_clk_src_mem);
+					if (cur && abs((int)cur - (int)freq) < (int)(freq / 20))
