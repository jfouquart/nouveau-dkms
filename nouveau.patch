+static int
+gf100_ram_calc_ddr3(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	u32 cur = nvkm_clk_read(device->clk, nv_clk_src_mem);
+	u32 lo, hi;
+
+	/* Class A: accept any VBIOS memory clock, not just the GF106M pair.
+	 * lo/hi are discovered from the board's own pstate table at init
+	 * (gf100_ram_init); unknown boards fall back to the GF106M pair
+	 * until their script is captured (TODO Class B board registry).
+	 * The 135 MHz alias is GF106M state 03's boot request. */
+	if (freq == 135000)
+		freq = 324000;
+
+	lo = ram->ddr3_lo ? ram->ddr3_lo : 324000;
+	hi = ram->ddr3_hi ? ram->ddr3_hi : 900000;
+	if (freq != lo && freq != hi) {
+		nvkm_error(subdev, "DDR3: unsupported memory clock %u kHz (board pair %u/%u)\n",
+			   freq, lo, hi);
+		return -EINVAL;
+	}
+
+	/* Already there (within 1%): do NOT retime DRAM for nothing.
+	 * However, on initial boot at 324 MHz when the resident Falcon
+	 * executor is not yet uploaded, pre-warm it once so the very first
+	 * 07 -> 0f transition executes on the sub-200us resident fast-path. */
+	if (cur && abs((int)cur - (int)freq) < (int)(freq / 100)) {
+		if (!fexec_resident_running && cur <= 400000) {
+			nvkm_info(subdev, "DDR3: pre-warming resident Falcon executor at %u kHz\n", cur);
+			return gf100_ram_exec_custom(ram, freq);
+		}
+		nvkm_debug(subdev, "DDR3: memory already at %u kHz\n", cur);
+		return 0;
+	}
+
+	nvkm_info(subdev, "DDR3: reclocking memory %u -> %u kHz (custom Falcon executor)\n",
+		  cur, freq);
+
+
+
+	/* No ram_init: the custom executor needs no MEMX struct, no INFO
+	 * query and no PMU firmware running.  fuc stays untouched (fb
+	 * NULL), so prog() below safely no-ops via its fb guard. */
+	return gf100_ram_exec_custom(ram, freq);
