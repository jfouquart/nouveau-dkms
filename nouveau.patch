+
+/******************************************************************************
+ * Fermi DDR3 (GF106M / GT 555M) memory reclocking
+ *
+ * gf100_ram_calc() below is Ben Skeggs' GDDR5 sequence for the GF100
+ * reference board.  Its DDR3 mode-register values (0x10f300 = 0x11d/0x84d,
+ * GDDR5 MRS encodings) are not valid for DDR3 and corrupt VRAM instantly.
+ *
+ * The sequence here is a verbatim replay of the PMU script uploaded by the
+ * NVIDIA 390.157 driver on this board (decoded from mmiotrace with
+ * tools/decode-pmu-memx.py), followed by the host-side PHY tune the blob
+ * applies after the script completes.  Only the two VBIOS memory clocks
+ * (324 MHz / 900 MHz) exist for this hardware.
+ *
+ * Execution is by the custom Falcon program (tmp/memx_exec_custom.fuc,
+ * see RECLOCKING_NOTES.md §8.1), NOT the PMU firmware (its message path
+ * never answers) and NOT direct host MMIO (FB_PAUSE faults from the host
+ * and engines stay live).  The builder below emits a custom TLV script
+ * (op + fixed args, opcodes 1 ENTER, 2 LEAVE, 3 WR32, 4 WAIT, 5 DELAY,
+ * 6 VBLANK) into DMEM scratch; the Falcon program walks it with full
+ * MMIO privilege.  DELAY carries host-precomputed loop iters
+ * (~ticks/us, SAFE direction: exact or longer, never shorter); WAIT
+ * carries a generous iteration bound (early exit on match, host 2s
+ * backstop covers pathology); VBLANK is a fixed spin (engines are
+ * paused, so sync is cosmetic).
+ *****************************************************************************/
+
+/* Custom-executor image (assembled from tmp/memx_exec_custom.fuc).
+ * Signals completion via PDAEMON.SCRATCH0 (0x10a080). */
+#include "fexec_code.inc"
+
+
+static void fexec_upload(struct nvkm_device *device, const u32 *code, int nwords)
+{
+	int i, npages = (nwords + 0x3f) >> 6;
+	int total_words = npages * 0x40;
+
+	/* Falcon v3+ IMEM pages are 256 bytes (64 words). The hardware
+	 * VTLB marks each page BUSY on first word write, and only marks it
+	 * USABLE when the last word (offset 0xfc) of the 64-word page is
+	 * written. If an unpadded code image is uploaded, the trailing
+	 * page stays BUSY, and the Falcon CPU instruction fetch freezes.
+	 * Pad every upload to complete 64-word pages. */
+	nvkm_wr32(device, 0x10a180, 0x01000000);
+	for (i = 0; i < total_words; i++) {
+		if ((i & 0x3f) == 0)
+			nvkm_wr32(device, 0x10a188, i >> 6);
+		nvkm_wr32(device, 0x10a184, (i < nwords) ? code[i] : 0);
+	}
+	nvkm_wr32(device, 0x10a180, 0x00000000);
+	(void)nvkm_rd32(device, 0x10a080);
+}
+
+static bool fexec_resident_running = false;
+
+/* VBlank-aligned memory reclock (Zero-Tear VBlank Onset Sync).
+ * On NV50/GF100 display hardware (dispnv50/head.c, nouveau_display.c),
+ * rgpos vline (0x616340) starts at 0 at VSync onset:
+ *   - 0 .. vblanke (0x610ae8 >> 16)         : VSync + VBlank back porch
+ *   - vblanke + 1 .. vblanks - 1            : Active display scanout
+ *   - vblanks (0x610af0 >> 16) .. vtotal - 1: VBlank front porch
+ * Signed vpos (matching nouveau_display.c calc()) is negative throughout
+ * Vertical Blanking (-vblank_lines .. -1) and 0 .. vdisplay-1 during active
+ * scanout. Waiting only for [vblanks .. vtotal) missed 90% of VBlank and
+ * timed out after 50ms when sleeping 200-500us.
+ * Here we sleep in short 80-150us steps until the pre-VBlank approach zone
+ * (last 40 active lines), then tight-poll with udelay(1) for the exact leading edge
+ * of VBlank so both the ~160us Falcon transition and the host 0x001548 PHY commit latch finish
+ * 100% inside a single VBlank interval. */
+static inline int
+gf100_ram_calc_vpos(u32 vblanks, u32 vblanke, u32 vtotal, u32 vline,
+		    int *vblank_lines, int *vdisplay)
+{
+	int vpos = (int)vline;
+	int blines;
+
+	if (vblanke >= vblanks) {
+		if (vpos >= (int)vblanks)
+			vpos -= (int)vtotal;
+		blines = (int)(vblanke - vblanks + 1);
+	} else {
+		if (vpos >= (int)vblanks)
+			vpos -= (int)vtotal;
+		vpos -= (int)vblanke + 1;
+		blines = (int)(vtotal - vblanks + vblanke + 1);
+	}
+	if (vblank_lines)
+		*vblank_lines = blines;
+	if (vdisplay)
+		*vdisplay = (int)vtotal - blines;
+	return vpos;
+}
+
+static int
+gf100_ram_read_vpos(struct nvkm_device *device, int head)
+{
+	u32 state_off = head * 0x540;
+	u32 rgpos_off = head * 0x800;
+	u32 vblanke = (nvkm_rd32(device, 0x610ae8 + state_off) >> 16) & 0xffff;
+	u32 vblanks = (nvkm_rd32(device, 0x610af0 + state_off) >> 16) & 0xffff;
+	u32 vtotal  = (nvkm_rd32(device, 0x610af8 + state_off) >> 16) & 0xffff;
+	u32 vline   = nvkm_rd32(device, 0x616340 + rgpos_off) & 0xffff;
+
+	if (vtotal == 0 || vblanks == 0 || vblanks >= vtotal)
+		return 0;
+	return gf100_ram_calc_vpos(vblanks, vblanke, vtotal, vline, NULL, NULL);
+}
+
+static int
+gf100_ram_wait_vblank(struct nvkm_device *device, int *out_head)
+{
+	struct nvkm_subdev *subdev;
+	unsigned long deadline;
+	u32 heads;
+	int head, i;
+
+	if (out_head)
+		*out_head = -1;
+	if (!nvkm_boolopt(device->cfgopt, "NvFermiVblankSync", true))
+		return 0;
+	if (!device->disp || !device->fb)
+		return 0;
+	subdev = &device->fb->subdev;
+	heads = nvkm_rd32(device, 0x610050);
+
+	for (head = 0; head < 2; head++) {
+		u32 vtotal, vblanks, vblanke, vline;
+		u32 state_off = head * 0x540;
+		u32 rgpos_off = head * 0x800;
+		int vblank_lines = 0, vdisplay = 0, vpos = 0;
+
+		if (heads && !(heads & (2 << (head << 3))))
+			continue;
+
+		vblanke = (nvkm_rd32(device, 0x610ae8 + state_off) >> 16) & 0xffff;
+		vblanks = (nvkm_rd32(device, 0x610af0 + state_off) >> 16) & 0xffff;
+		vtotal  = (nvkm_rd32(device, 0x610af8 + state_off) >> 16) & 0xffff;
+		if (vtotal == 0 || vblanks == 0 || vblanks >= vtotal)
+			continue;
+
+		if (out_head)
+			*out_head = head;
+
+		deadline = jiffies + msecs_to_jiffies(30);
+		while (time_before(jiffies, deadline)) {
+			vline = nvkm_rd32(device, 0x616340 + rgpos_off) & 0xffff;
+			vpos = gf100_ram_calc_vpos(vblanks, vblanke, vtotal, vline,
+						   &vblank_lines, &vdisplay);
+
+			/* Pre-VBlank approach zone: last 40 active lines before VBlank onset.
+			 * Tight-poll in 1us increments for the exact leading edge of VBlank. */
+			if (vdisplay > 45 && vpos >= vdisplay - 40) {
+				for (i = 0; i < 650; i++) {
+					vline = nvkm_rd32(device, 0x616340 + rgpos_off) & 0xffff;
+					vpos = gf100_ram_calc_vpos(vblanks, vblanke, vtotal, vline,
+								   &vblank_lines, &vdisplay);
+					if (vpos < 0 || vpos >= vdisplay - 2)
+						return vpos;
+					udelay(1);
+				}
+				return vpos;
+			}
+
+			usleep_range(80, 150);
+		}
+		nvkm_debug(subdev, "DDR3: vblank wait timeout on head %d (vpos %d, blank %u..%u/%u)\n",
+			   head, vpos, vblanks, vblanke, vtotal);
+		return vpos;
+	}
+	return 0;
+}
+
+static int
+gf100_ram_exec_custom(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	unsigned long deadline;
+	u32 done = 0, cur = 0, pmc, cmd;
+	int i, sync_head = -1, vpos_start = 0, vpos_end = 0;
+	ktime_t t_start;
+	s64 exec_us;
+
+	cmd = (freq == 900000) ? 1 : 2;
+
+	/* Check if resident executor is already running and ready in Falcon IMEM */
+	if (fexec_resident_running) {
+		u32 s0 = nvkm_rd32(device, 0x10a080);
+
+		/* Across S3 suspend/resume or Falcon reset, IMEM is cleared and S0 drops to 0x0.
+		 * If our resident handshake signature (0xE1EC0001) is missing, Falcon is uninitialized.
+		 * Fall back immediately to the cold path to reload the resident executor. */
+		if (s0 != 0xE1EC0001) {
+			nvkm_info(subdev, "DDR3: Falcon lost resident executor across suspend/reset (S0=%08x, PC=%08x), reloading via cold path\n",
+				  s0, nvkm_rd32(device, 0x10aff0));
+			fexec_resident_running = false;
+		}
+	}
+
+	if (fexec_resident_running) {
+		u32 uc_ctrl = nvkm_rd32(device, 0x10a100);
+		u32 pc = nvkm_rd32(device, 0x10aff0);
+
+		if (unlikely(uc_ctrl & 0x10)) {
+			nvkm_warn(subdev, "DDR3: Falcon stopped (UC=%08x, PC=%08x), restarting directly without PMC reset\n",
+				  uc_ctrl, pc);
+		}
+
+		/* Wait for exact VBlank onset immediately before triggering Falcon.
+		 * Do NOT call printk/nvkm_info between vblank sync and 0x10a084 trigger! */
+		vpos_start = gf100_ram_wait_vblank(device, &sync_head);
+		t_start = ktime_get();
+
+		if (unlikely(uc_ctrl & 0x10)) {
+			nvkm_wr32(device, 0x10a080, 0x00000000);
+			nvkm_wr32(device, 0x10a084, cmd);
+			nvkm_wr32(device, 0x10a10c, 0x00000000);
+			nvkm_wr32(device, 0x10a104, 0x00000000);
+			nvkm_wr32(device, 0x10a100, 0x00000002);
+		} else {
+			/* Falcon is running resident: write command to SCRATCH3 */
+			nvkm_wr32(device, 0x10a080, 0x00000000);  /* clear DONE */
+			nvkm_wr32(device, 0x10a084, cmd);         /* send cmd: 1=900, 2=324 */
+		}
+		(void)nvkm_rd32(device, 0x10a084);
+
+		/* Fast tight-poll for the first 600us so we catch completion (~160us)
+		 * and strobe the 0x001548 PHY commit latch while STILL inside VBlank! */
+		for (i = 0; i < 300; i++) {
+			done = nvkm_rd32(device, 0x10a080);
+			if (done)
+				break;
+			udelay(2);
+		}
+		if (!done) {
+			deadline = jiffies + msecs_to_jiffies(2000);
+			do {
+				done = nvkm_rd32(device, 0x10a080);
+				if (done)
+					break;
+				usleep_range(100, 200);
+			} while (time_before(jiffies, deadline));
+		}
+
+		if (done == 0xE1EC0001) {
+			/* Assert hardware PHY timing commit latch from host inside VBlank */
+			nvkm_wr32(device, 0x001548, 0x00000101);
+			nvkm_wr32(device, 0x001548, 0x80000101);
+			(void)nvkm_rd32(device, 0x001548);
